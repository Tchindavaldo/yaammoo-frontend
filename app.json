{
  "expo": {
    "name": "yaammoo",
    "slug": "yaammoo",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "yaammoo",
    "userInterfaceStyle": "automatic",
    "updates": {
      "url": "https://u.expo.dev/24675cd4-f658-43d1-9bfc-0ce0ff16a007",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": "1.1.2",
    "extra": {
      "eas": {
        "projectId": "24675cd4-f658-43d1-9bfc-0ce0ff16a007"
      },
      "router": {}
    },
    "ios": {
      "supportsTablet": false,
      "buildNumber": "28",
      "bundleIdentifier": "com.rauval.yaammoo",
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "LSApplicationQueriesSchemes": [
          "comgooglemaps"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Yaammoo utilise votre position pour afficher les restaurants et marchands à proximité.",
        "NSPhotoLibraryUsageDescription": "Yaammoo a besoin d'accéder à vos photos pour ajouter des images à votre boutique et à vos menus.",
        "NSPhotoLibraryAddUsageDescription": "Yaammoo enregistre dans vos photos les images que vous exportez.",
        "NSCameraUsageDescription": "Yaammoo utilise l'appareil photo pour photographier vos plats et votre boutique.",
        "NSMicrophoneUsageDescription": "Yaammoo utilise le micro pour vos notes vocales destinées aux livreurs.",
        "NSFaceIDUsageDescription": "Yaammoo utilise Face ID pour protéger l'accès à votre portefeuille."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rauval.yaammoo",
      "versionCode": 19,
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBO2b5OxgzRk1ayuQpma1MXU7sNM_zdN1s"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.rauval.yaammoo.** { *; }\n-keep class expo.modules.** { *; }\n-keepclassmembers class * { @com.facebook.proguard.annotations.DoNotStrip *; @com.facebook.common.internal.DoNotStrip *; }\n-keep class io.sentry.** { *; }\n-keep class com.google.android.gms.** { *; }\n-dontwarn com.google.android.gms.**"
          },
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-router",
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": "Yaammoo utilise le micro pour vos notes vocales destinées aux livreurs.",
          "enableBackgroundPlayback": false
        }
      ],
      "expo-image",
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#ffffff"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      "expo-font",
      "./plugins/withModularHeadersFix",
      "./plugins/withXcodeCloud",
      [
        "@sentry/react-native",
        {
          "organization": "rauval",
          "project": "react-native"
        }
      ],
      "react-native-compressor",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo-notification-white.png"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "rauval"
  }
}
